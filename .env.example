# Sao chép thành .env rồi điền giá trị của dự án Supabase tương ứng.
# Cả hai biến đều là giá trị công khai; xem chú thích trong .env.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Tùy chọn. Gốc của Lex & Lineage, nơi mục "Văn bản pháp luật" lấy tình trạng
# hiệu lực lúc build và dẫn người đọc sang. Bỏ trống thì dùng
# https://lexnlineage.vercel.app.
# VITE_LEX_LINEAGE_URL=https://lexnlineage.vercel.app
